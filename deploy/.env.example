# Copy to deploy/.env and change every value. Never commit the real file.
POSTGRES_USER=kurwall
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=kurwall

CLICKHOUSE_USER=kurwall
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=kurwall

# Optional static bearer token for automation. At least 16 characters.
# User accounts created with `kurwall users create-admin` take precedence for
# the dashboard; the token remains an administrator credential.
KURWALL_API_TOKEN=

# Published host addresses. Bind the dashboard to loopback behind a reverse
# proxy; bind the agent gRPC port to a private/VPN address that nodes can reach.
KURWALL_HTTP_BIND_ADDR=127.0.0.1
KURWALL_GRPC_BIND_ADDR=0.0.0.0
# Legacy fallback for both ports, used only when the two variables above are
# unset:
# KURWALL_BIND_ADDR=127.0.0.1

# Public web/API origin for the dashboard, /install.sh and /agent/* assets.
# This may be a different host than the gRPC endpoint below.
KURWALL_PUBLIC_URL=http://127.0.0.1:8080
# Address agents dial. Set a different host or port when gRPC is exposed
# separately, for example grpc.example.com:9090. Empty derives the host from
# public_url and the gRPC port.
KURWALL_GRPC_PUBLIC_ADDR=
# TLS name agents verify for gRPC. Keep kurwall-coordinator when the
# coordinator certificate is used; set the external hostname when a proxy
# presents a certificate for that name.
KURWALL_GRPC_SERVER_NAME=kurwall-coordinator
# Host directory with the output of `make agent-dist` (production compose).
KURWALL_AGENT_DIST_DIR=./agent-dist

# Optional ASN resolver URL overrides (defaults use RIPEstat).
# KURWALL_ASN_PREFIX_URL=https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS{asn}
# KURWALL_ASN_HOLDER_URL=https://stat.ripe.net/data/as-overview/data.json?resource=AS{asn}
# KURWALL_ASN_CATALOG_URL=https://iptoasn.com/data/ip2asn-combined.tsv.gz
# Some networks cannot download the 9 MB combined feed from iptoasn in time.
# This mirror carries the same current feed:
# KURWALL_ASN_CATALOG_URL=http://www.db.mirror.stargrave.org/ip/ip2asn-combined.tsv.gz

# Production image tag (compose.prod.yml only).
KURWALL_COORDINATOR_IMAGE=ghcr.io/nrf24l01/kurwall/coordinator:latest