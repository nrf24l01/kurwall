# Standalone Kurwall server configuration.
# Download as `.env` next to compose.yml and change every value marked here.
# Never commit this file.

POSTGRES_USER=kurwall
POSTGRES_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_24
POSTGRES_DB=kurwall

CLICKHOUSE_USER=kurwall
CLICKHOUSE_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_24
CLICKHOUSE_DB=kurwall

# Optional static administrator bearer token for automation.
KURWALL_API_TOKEN=

# Address on which the dashboard (8080) and agent gRPC (9090) are published.
# Use 127.0.0.1 for HTTP behind a reverse proxy, but keep 9090 reachable by
# agents with KURWALL_GRPC_BIND_ADDR.
KURWALL_BIND_ADDR=0.0.0.0
# KURWALL_HTTP_BIND_ADDR=127.0.0.1
# KURWALL_GRPC_BIND_ADDR=0.0.0.0

# Browser/API origin. Replace SERVER_IP with the address nodes can reach.
KURWALL_PUBLIC_URL=http://SERVER_IP:8080
# Address agents dial. May use a different hostname or port.
KURWALL_GRPC_PUBLIC_ADDR=SERVER_IP:9090
# TLS name agents verify. Keep kurwall-coordinator with the generated CA.
KURWALL_GRPC_SERVER_NAME=kurwall-coordinator

# SANs for the coordinator certificate generated by the init container.
# Add the public DNS name if agents verify it directly.
KURWALL_TLS_SAN=DNS:kurwall-coordinator,DNS:localhost,IP:127.0.0.1,IP:SERVER_IP

KURWALL_COORDINATOR_IMAGE=ghcr.io/nrf24l01/kurwall/coordinator:latest

# Optional ASN source overrides. The catalog defaults to the official iptoasn
# combined feed; set the catalog URL only to an iptoasn-compatible mirror that
# is reachable from the coordinator host. Labels appear after the catalog loads;
# catalog failures never block event ingestion.
# KURWALL_ASN_CATALOG_URL=https://mirror.example.com/ip2asn-combined.tsv.gz
# KURWALL_ASN_PREFIX_URL=https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS{asn}
# KURWALL_ASN_HOLDER_URL=https://stat.ripe.net/data/as-overview/data.json?resource=AS{asn}